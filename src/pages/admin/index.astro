<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Painel da Loja (Admin)</title>
    <meta name="robots" content="noindex,nofollow" />
    <style>
      :root{
        --bg:#f7f7fb;
        --card:#ffffff;
        --text:#111827;
        --muted:#6b7280;
        --border:#e5e7eb;
        --primary:#7f1d1d;
        --ok-bg:#ecfdf5;
        --ok-border:#bbf7d0;
        --ok-text:#166534;
        --err-bg:#fef2f2;
        --err-border:#fecaca;
        --err-text:#991b1b;
        --chip:#f3f4f6;
        --shadow: 0 1px 0 rgba(0,0,0,0.02);
      }
      body { margin: 0; font-family: system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Cantarell, Noto Sans, sans-serif; background:var(--bg); color:var(--text); }
      .wrap { max-width: 1050px; margin: 0 auto; padding: 20px; }
      .card { border: 1px solid var(--border); border-radius: 14px; padding: 18px; background: var(--card); box-shadow: var(--shadow); }
      label { display:block; font-weight: 650; margin: 12px 0 6px; font-size: 13px; }
      input, select, textarea { width: 100%; padding: 11px 12px; border: 1px solid var(--border); border-radius: 12px; background:#fff; }
      textarea { min-height: 110px; resize: vertical; }
      button { padding: 11px 14px; border-radius: 12px; border: 0; cursor: pointer; background: var(--primary); color: #fff; font-weight: 650; }
      button:disabled { opacity: .65; cursor:not-allowed; }
      .row { display:grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      @media (max-width: 720px) { .row { grid-template-columns: 1fr; } }
      .muted { color:var(--muted); font-size: 13px; }
      .muted strong{ color:#374151; }
      .ok { background:var(--ok-bg); border:1px solid var(--ok-border); color:var(--ok-text); padding:12px; border-radius: 12px; margin-top: 12px; }
      .err { background:var(--err-bg); border:1px solid var(--err-border); color:var(--err-text); padding:12px; border-radius: 12px; margin-top: 12px; }
      .actions { display:flex; gap: 10px; align-items:center; justify-content: space-between; flex-wrap: wrap; }
      .actions-left { display:flex; align-items:center; gap: 10px; flex-wrap: wrap; }
      .ghost { background: transparent; border: 1px solid var(--border); color:#111827; padding: 10px 14px; }
      .small { font-size: 13px; }
      .two-col { display:grid; grid-template-columns: 1fr 1fr; gap: 14px; }
      @media (max-width: 980px) { .two-col { grid-template-columns: 1fr; } }
      .section-title{ margin: 0 0 6px; font-size: 16px; }
      .hr{ height:1px; background:var(--border); margin: 14px 0; }
      .chip{ display:inline-flex; align-items:center; gap:8px; padding: 6px 10px; border-radius: 999px; background: var(--chip); font-size: 12px; font-weight: 650; }
      .badge{
        display:inline-block; font-size: 12px; font-weight: 650;
        padding: 6px 10px; border-radius: 999px;
      }
      .badge.disponivel{ background: var(--ok-bg); border:1px solid var(--ok-border); color: var(--ok-text); }
      .badge.esgotado{ background: var(--err-bg); border:1px solid var(--err-border); color: var(--err-text); }
      table { width: 100%; border-collapse: collapse; }
      th, td { padding: 10px; border-bottom: 1px solid var(--border); vertical-align: top; }
      th { text-align:left; font-size: 12px; color:var(--muted); text-transform: uppercase; letter-spacing: .02em; }
      .table-wrap{ overflow:auto; border: 1px solid var(--border); border-radius: 12px; background:#fff; }
      .img-preview{
        display:flex; gap:12px; align-items:flex-start; padding: 12px; border: 1px dashed #d1d5db;
        border-radius: 12px; background:#fafafa;
      }
      .img-preview img{
        width: 92px; height: 92px; object-fit: cover; border-radius: 12px;
        border: 1px solid var(--border); background:#fff;
      }
      .img-preview .hint{ font-size: 13px; color: var(--muted); line-height: 1.35; }
      .form-actions{ display:flex; align-items:center; gap: 12px; flex-wrap: wrap; }
      .result-area{ min-height: 44px; }
      .btn-row{ display:flex; gap:10px; flex-wrap: wrap; align-items:center; margin-top: 12px; }
      .btn-row button{ margin-top:0; }
    </style>
  </head>

  <body>
    <div class="wrap">
      <div id="app"></div>
    </div>

    <script type="module">
      const ADMIN_TOKEN_KEY = 'admin_token';
      const API_BASE = '';
      const endpoint = `${API_BASE}/.netlify/functions/admin-products`;
      const app = document.getElementById('app');

      function escapeHtml(str) {
        return String(str ?? '')
          .replaceAll('&', '&amp;')
          .replaceAll('<', '<')
          .replaceAll('>', '>')
          .replaceAll('"', '"')
          .replaceAll("'", '&#39;');
      }

      function statusLabel(s){
        const v = String(s ?? 'disponivel');
        if (v === 'esgotado') return { text: 'Esgotado', cls: 'esgotado' };
        return { text: 'Disponível', cls: 'disponivel' };
      }

      function renderLogin() {
        app.innerHTML = `
          <div class="card">
            <h2 style="margin:0 0 6px;">Acesso ao Painel</h2>
            <div class="muted">Use a senha para editar os produtos.</div>

            <label>Senha do painel</label>
            <input id="pw" type="password" placeholder="••••••" autocomplete="current-password" />

            <div class="btn-row">
              <button id="btn" type="button">Entrar</button>
            </div>

            <div id="msg" class="muted" style="margin-top:10px" aria-live="polite"></div>
          </div>
        `;

        const btn = document.getElementById('btn');
        const pw = document.getElementById('pw');
        const msg = document.getElementById('msg');

        btn.addEventListener('click', async () => {
          msg.textContent = 'A validar...';
          btn.disabled = true;
          const password = pw.value;

          try {
            const res = await fetch(endpoint + '?action=login', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ password })
            });

            const data = await res.json().catch(() => ({}));
            if (!res.ok || !data?.ok) {
              msg.textContent = data?.error || 'Senha inválida.';
              return;
            }

            localStorage.setItem(ADMIN_TOKEN_KEY, data.token);
            await renderAdmin();
          } catch (e) {
            msg.textContent = 'Erro ao conectar.';
          } finally {
            btn.disabled = false;
          }
        });
      }

      async function authedFetch(action, payload) {
        const token = localStorage.getItem(ADMIN_TOKEN_KEY);
        const res = await fetch(endpoint + '?action=' + encodeURIComponent(action), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, ...(payload || {}) })
        });
        const data = await res.json().catch(() => ({}));
        return { ok: res.ok, data };
      }

      async function authedMultipart(action, form) {
        // não setar Content-Type manualmente (o browser define o boundary)
        const res = await fetch(endpoint + '?action=' + encodeURIComponent(action), {
          method: 'POST',
          body: form
        });
        const data = await res.json().catch(() => ({}));
        return { ok: res.ok, data };
      }

      function getExamples(products){
        const catalogo = products.find(p => p.categoria === 'catalogo');
        const kit = products.find(p => p.categoria === 'kit');
        return {
          catalogoImg: catalogo?.imagem || '',
          kitImg: kit?.imagem || '',
          catalogo: catalogo || null,
          kit: kit || null
        };
      }

      async function renderAdmin() {
        const authToken = localStorage.getItem(ADMIN_TOKEN_KEY);
        if (!authToken) return renderLogin();

        const auth = await authedFetch('list');
        if (!auth.ok) {
          localStorage.removeItem(ADMIN_TOKEN_KEY);
          return renderLogin();
        }

        const products = auth.data?.products || [];
        const examples = getExamples(products);

        app.innerHTML = `
          <div class="card" style="margin-bottom:16px;">
            <div class="actions">
              <div class="actions-left">
                <h2 style="margin:0;">Editar Produtos</h2>
                <span class="chip">
                  <span>Registos</span>
                  <strong>${escapeHtml(products.length)}</strong>
                </span>
              </div>
              <button class="ghost" id="logout" type="button">Sair</button>
            </div>
            <div class="muted" style="margin-top:8px;">
              Atualiza os dados do catálogo. <strong>Trocar foto = upload real</strong>.
            </div>
          </div>

          <div class="two-col">
            <div class="card">
              <h3 class="section-title" style="margin-top:0">1) Dados do produto</h3>
              <div class="muted small" style="margin-bottom:14px;">
                Preencha os campos e clique em <strong>Salvar</strong>.
              </div>

              <div class="row">
                <div>
                  <label>ID (número)</label>
                  <input id="f_id" type="number" min="1" placeholder="Ex.: 1 ou 101" />
                  <div class="muted" style="margin-top:6px;">Dica: se for um novo produto, use um ID que ainda não exista.</div>
                </div>
                <div>
                  <label>Categoria</label>
                  <select id="f_cat">
                    <option value="catalogo">Catálogo</option>
                    <option value="kit">Kits</option>
                  </select>
                </div>
              </div>

              <div class="row">
                <div>
                  <label>Nome</label>
                  <input id="f_nome" type="text" placeholder="Ex.: Laço grande (unidade)" />
                </div>
                <div>
                  <label>Preço</label>
                  <input id="f_preco" type="text" placeholder="Ex.: 2.800,00 Kz" />
                </div>
              </div>

              <label>Descrição</label>
              <textarea id="f_desc" placeholder="Escreva uma descrição curta e clara do produto."></textarea>

              <div class="hr"></div>

              <h3 class="section-title" style="margin:0 0 6px;">2) Foto e Estado</h3>

              <div class="img-preview">
                <div>
                  <img id="img_preview" src="${escapeHtml(examples.kitImg || examples.catalogoImg || '')}" alt="Pré-visualização" />
                </div>
                <div class="hint">
                  <strong>Upload real:</strong> escolha o ficheiro no computador.
                  <div class="muted" style="margin-top:6px;">
                    A imagem será guardada e o painel grava o caminho no <strong>products.json</strong>.
                  </div>
                </div>
              </div>

              <div class="row" style="margin-top:14px;">
                <div>
                  <label>Foto (upload real)</label>
                  <input id="f_img_file" type="file" accept="image/*" />
                  <div class="muted" style="margin-top:6px;">Se não escolher ficheiro, a foto atual mantém-se.</div>
                  <input id="f_img_current" type="hidden" />
                </div>
                <div>
                  <label>Estado</label>
                  <select id="f_status">
                    <option value="disponivel">Disponível</option>
                    <option value="esgotado">Esgotado</option>
                  </select>
                  <div style="margin-top:10px;">
                    <span id="status_badge" class="badge disponivel">Disponível</span>
                  </div>
                </div>
              </div>

              <label>Video URL (opcional)</label>
              <input id="f_vid" type="text" placeholder="https://..." />

              <div class="form-actions" style="margin-top:14px;">
                <button id="save" type="button">Salvar</button>
                <div id="result" class="result-area"></div>
              </div>

              <div class="muted" style="margin-top:12px;">
                Após salvar, pode demorar um pouco até o site atualizar.
              </div>
            </div>

            <div class="card">
              <h3 class="section-title" style="margin-top:0">3) Lista (carregar para editar)</h3>
              <div class="muted small" style="margin-bottom:10px;">
                Use a busca para encontrar rápido por <strong>ID</strong> ou <strong>nome</strong>.
              </div>

              <div class="row" style="grid-template-columns: 1fr 160px;">
                <div>
                  <label style="margin-top:0;">Buscar</label>
                  <input id="f_search" type="text" placeholder="Ex.: 101 ou laços" />
                </div>
                <div>
                  <label style="margin-top:0;">Categoria</label>
                  <select id="f_search_cat">
                    <option value="all">Todas</option>
                    <option value="catalogo">Catálogo</option>
                    <option value="kit">Kits</option>
                  </select>
                </div>
              </div>

              <div class="table-wrap" style="margin-top:12px;">
                <table>
                  <thead>
                    <tr>
                      <th>ID</th>
                      <th>Nome</th>
                      <th>Categoria</th>
                      <th>Preço</th>
                      <th>Estado</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody id="products_tbody"></tbody>
                </table>
              </div>

              <div class="muted" style="margin-top:10px;">
                Dica: clique em <strong>Carregar</strong> para preencher o formulário.
              </div>
            </div>
          </div>
        `;

        document.getElementById('logout').addEventListener('click', () => {
          localStorage.removeItem(ADMIN_TOKEN_KEY);
          renderLogin();
        });

        const imgPreviewEl = document.getElementById('img_preview');
        const f_img_file = document.getElementById('f_img_file');
        const f_img_current = document.getElementById('f_img_current');

        function updateImgPreview(){
          const file = f_img_file?.files?.[0];
          if (file) {
            const url = URL.createObjectURL(file);
            imgPreviewEl.src = url;
            imgPreviewEl.alt = 'Pré-visualização (upload)';
            return;
          }
          const current = String(f_img_current?.value ?? '').trim();
          if (current) {
            imgPreviewEl.src = current;
            imgPreviewEl.alt = 'Foto atual';
            return;
          }
          imgPreviewEl.removeAttribute('src');
        }

        f_img_file?.addEventListener('change', () => updateImgPreview());

        function setStatusPreview(){
          const status = document.getElementById('f_status')?.value;
          const badge = document.getElementById('status_badge');
          if (!badge) return;
          const s = statusLabel(status);
          badge.className = `badge ${s.cls}`;
          badge.textContent = s.text;
        }

        document.getElementById('f_status').addEventListener('change', setStatusPreview);
        setStatusPreview();

        const products_tbody = document.getElementById('products_tbody');

        function renderTable() {
          const search = String(document.getElementById('f_search').value ?? '').trim().toLowerCase();
          const cat = document.getElementById('f_search_cat').value;

          const filtered = products.filter(p => {
            const pcat = String(p.categoria ?? '');
            const okCat = cat === 'all' ? true : pcat === cat;
            const hayId = String(p.id ?? '').toLowerCase();
            const hayNome = String(p.nome ?? '').toLowerCase();
            const okSearch = !search ? true : hayId.includes(search) || hayNome.includes(search);
            return okCat && okSearch;
          });

          products_tbody.innerHTML = filtered.map(p => {
            const s = statusLabel(p.status || 'disponivel');
            return `
              <tr>
                <td>${escapeHtml(p.id)}</td>
                <td>${escapeHtml(p.nome)}</td>
                <td>${escapeHtml(p.categoria)}</td>
                <td>${escapeHtml(p.preco)}</td>
                <td><span class="badge ${s.cls}">${escapeHtml(s.text)}</span></td>
                <td><button class="ghost" data-load="${escapeHtml(p.id)}" type="button">Carregar</button></td>
              </tr>
            `;
          }).join('');
        }

        document.getElementById('f_search').addEventListener('input', renderTable);
        document.getElementById('f_search_cat').addEventListener('change', renderTable);
        renderTable();

        function setForm(p) {
          document.getElementById('f_id').value = p.id;
          document.getElementById('f_cat').value = p.categoria;
          document.getElementById('f_nome').value = p.nome;
          document.getElementById('f_preco').value = p.preco;
          document.getElementById('f_desc').value = p.descricao;
          document.getElementById('f_vid').value = p.videoUrl || '';
          document.getElementById('f_status').value = p.status || 'disponivel';

          f_img_current.value = p.imagem || '';
          if (f_img_file) f_img_file.value = '';
          updateImgPreview();
          setStatusPreview();
        }

        document.addEventListener('click', (e) => {
          const btn = e.target?.closest?.('[data-load]');
          if (!btn) return;
          const id = Number(btn.getAttribute('data-load'));
          const p = products.find(x => Number(x.id) === id);
          if (p) setForm(p);
        });

        document.getElementById('save').addEventListener('click', async () => {
          const out = document.getElementById('result');
          out.className = '';
          out.textContent = '';

          const f_id = document.getElementById('f_id');
          const f_cat = document.getElementById('f_cat');
          const f_nome = document.getElementById('f_nome');
          const f_preco = document.getElementById('f_preco');
          const f_desc = document.getElementById('f_desc');
          const f_status = document.getElementById('f_status');
          const f_vid = document.getElementById('f_vid');

          const payloadBase = {
            id: Number(f_id.value),
            categoria: f_cat.value,
            nome: f_nome.value,
            preco: f_preco.value,
            descricao: f_desc.value,
            status: f_status.value,
            videoUrl: (f_vid.value || undefined)
          };

          if (!Number.isFinite(payloadBase.id) || payloadBase.id < 1) {
            out.className = 'err';
            out.textContent = 'ID inválido. Use um número (ex.: 1 ou 101).';
            return;
          }
          if (!String(payloadBase.nome ?? '').trim()) {
            out.className = 'err';
            out.textContent = 'Nome é obrigatório.';
            return;
          }
          if (!String(payloadBase.preco ?? '').trim()) {
            out.className = 'err';
            out.textContent = 'Preço é obrigatório.';
            return;
          }
          if (!String(payloadBase.descricao ?? '').trim()) {
            out.className = 'err';
            out.textContent = 'Descrição é obrigatória.';
            return;
          }
          if (!payloadBase.status || !['disponivel','esgotado'].includes(String(payloadBase.status))) {
            out.className = 'err';
            out.textContent = 'Estado inválido (escolha “Disponível” ou “Esgotado”).';
            return;
          }

          const saveBtn = document.getElementById('save');
          const file = f_img_file?.files?.[0];

          try {
            saveBtn.disabled = true;
            out.className = 'muted';
            out.textContent = 'A salvar...';

            let res;

            if (file) {
              // Upload real multipart (campo name="imagem")
              const form = new FormData();
              form.append('token', localStorage.getItem(ADMIN_TOKEN_KEY) || '');
              form.append('id', String(payloadBase.id));
              form.append('categoria', payloadBase.categoria);
              form.append('nome', payloadBase.nome);
              form.append('preco', payloadBase.preco);
              form.append('descricao', payloadBase.descricao);
              form.append('status', payloadBase.status);
              if (payloadBase.videoUrl) form.append('videoUrl', String(payloadBase.videoUrl));
              form.append('imagem', file, file.name);

              res = await authedMultipart('save', form);
            } else {
              // Sem trocarr foto: envia JSON com a imagem atual.
              const imagemAtual = String(f_img_current?.value ?? '').trim();
              if (!imagemAtual) {
                out.className = 'err';
                out.textContent = 'Escolha uma foto (upload real) para esta referência.';
                return;
              }

              res = await authedFetch('save', {
                ...payloadBase,
                imagem: imagemAtual
              });
            }

            const data = res.data;
            if (!res.ok || !data?.ok) {
              out.className = 'err';
              out.textContent = data?.error || 'Erro ao salvar.';
              return;
            }

            out.className = 'ok';
            out.textContent = 'Salvo! A foto e os dados foram atualizados.';
          } finally {
            saveBtn.disabled = false;
          }
        });

        updateImgPreview();
      }

      if (localStorage.getItem(ADMIN_TOKEN_KEY)) {
        renderAdmin();
      } else {
        renderLogin();
      }
    </script>
  </body>
</html>

