---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout title="Painel administrativo">
  <main id="conteudo-principal" class="mx-auto min-h-screen max-w-4xl px-5 py-10 md:px-8">
    <div id="app" aria-live="polite"></div>
  </main>

  <script>
    const endpoint = '/.netlify/functions/admin-products';
    const app = document.querySelector('#app');
    const e = (value) => String(value ?? '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#39;');
    const slug = (value) => String(value ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    const stock = (status) => status === 'esgotado'
      ? '<span class="rounded-full border border-border px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-muted">Esgotado</span>'
      : '<span class="rounded-full border border-border px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-text">Disponível</span>';
    const button = 'rounded-full border border-border px-4 py-2 text-xs font-semibold uppercase tracking-wider transition duration-300 hover:border-text';
    const input = 'w-full rounded-xl border border-border bg-bg px-4 py-2.5 text-sm text-text outline-none transition duration-300 placeholder:text-muted focus:border-text';

    async function request(action, body, multipart = false) {
      const response = await fetch(`${endpoint}?action=${encodeURIComponent(action)}`, {
        method: 'POST',
        headers: multipart ? undefined : { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: multipart ? body : JSON.stringify(body || {})
      });
      return { ok: response.ok, data: await response.json().catch(() => ({})) };
    }

    function showLogin(message = '') {
      app.innerHTML = `
        <section class="mx-auto max-w-md rounded-3xl border border-border p-6 sm:p-8">
          <p class="text-xs font-medium uppercase tracking-[0.3em] text-muted">Área reservada</p>
          <h1 class="mt-3 font-[Manrope] text-2xl font-semibold text-text">Painel da loja</h1>
          <p class="mt-2 text-sm leading-6 text-muted">Inicie sessão para gerir os produtos do catálogo.</p>
          <form id="login-form" class="mt-7 space-y-4">
            <div><label for="password" class="text-xs font-medium uppercase tracking-wider text-text">Senha do painel</label><input id="password" class="${input} mt-2" type="password" autocomplete="current-password" required /></div>
            <button class="rounded-full bg-text px-5 py-2.5 text-xs font-semibold uppercase tracking-wider text-bg transition duration-300 hover:bg-accent" type="submit">Entrar</button>
          </form>
          <p id="status" class="${message ? '' : 'hidden '}mt-6 rounded-xl border border-red-200 px-4 py-3 text-sm text-red-700">${e(message)}</p>
        </section>`;
      app.querySelector('#login-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget, statusEl = app.querySelector('#status'), submit = form.querySelector('button');
        submit.disabled = true;
        const response = await fetch(`${endpoint}?action=login`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ password: form.password.value }) }).catch(() => null);
        const data = await response?.json().catch(() => ({}));
        if (!response?.ok || !data?.ok) { statusEl.textContent = data?.error || 'Não foi possível ligar ao painel.'; statusEl.classList.remove('hidden'); submit.disabled = false; return; }
        renderAdmin();
      });
    }

    function header(products) {
      return `<header class="flex flex-col gap-4 border-b border-border pb-8 sm:flex-row sm:items-center sm:justify-between">
        <div><p class="text-xs font-medium uppercase tracking-[0.3em] text-muted">Gestão de catálogo</p><h1 class="mt-2 font-[Manrope] text-2xl font-semibold text-text">Produtos <span class="text-muted">(${products.length})</span></h1></div>
        <div class="flex flex-wrap gap-2"><a href="/" class="${button}">Ver loja</a><button id="fill-slugs" class="${button}" type="button">Preencher slugs</button><button id="new-product" class="rounded-full bg-text px-4 py-2 text-xs font-semibold uppercase tracking-wider text-bg transition duration-300 hover:bg-accent" type="button">Novo produto</button></div>
      </header>`;
    }

    function productCard(product) {
      const image = product.images?.find((image) => image.isCover)?.url || product.images?.[0]?.url || product.imagem || '';
      const productSlug = product.slug || slug(product.nome);
      return `<article class="flex gap-4 rounded-2xl border border-border p-4 transition duration-300 hover:shadow-[0_20px_40px_rgba(0,0,0,0.06)]">
        <img class="h-20 w-20 shrink-0 rounded-xl bg-[#f7f7f7] object-cover" src="${e(image)}" alt="Fotografia do produto: ${e(product.nome)}" />
        <div class="min-w-0 flex-1"><div class="flex flex-wrap items-start justify-between gap-2"><div><h2 class="font-[Manrope] text-lg font-semibold text-text">${e(product.nome)}</h2><p class="mt-1 text-xs text-muted">${e(product.categoria === 'kit' ? 'Kit' : 'Catálogo')}</p></div>${stock(product.status)}</div>
          <p class="mt-2 line-clamp-2 text-sm leading-5 text-muted">${e(product.descricao)}</p>
          <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1"><span class="font-medium text-text">${e(product.preco)}</span>${product.preco_antigo ? `<del class="text-sm text-muted">${e(product.preco_antigo)}</del>` : ''}<a class="text-xs text-muted underline decoration-border underline-offset-4 hover:text-text" href="/produtos/${e(productSlug)}" target="_blank" rel="noopener">/produtos/${e(productSlug)}</a></div>
          <div class="mt-4 flex flex-wrap gap-2"><button data-edit="${e(product.id)}" class="${button}" type="button">Editar</button><button data-copy="/produtos/${e(productSlug)}" class="${button}" type="button">Copiar link</button><button data-stock="${e(product.id)}" class="${button}" type="button">${product.status === 'esgotado' ? 'Marcar disponível' : 'Marcar stock'}</button><button data-delete="${e(product.id)}" class="${button} text-red-700" type="button">Apagar</button></div>
        </div></article>`;
    }

    function dialog(product = {}) {
      const image = product.images?.find((entry) => entry.isCover)?.url || product.images?.[0]?.url || product.imagem || '';
      return `<dialog id="product-dialog" class="w-[calc(100%-2rem)] max-w-lg rounded-2xl border border-border bg-bg p-0 text-text shadow-xl backdrop:bg-black/40 open:flex open:flex-col">
        <form id="product-form" method="dialog"><header class="flex items-center justify-between border-b border-border px-6 py-4"><h2 class="font-[Manrope] text-lg font-semibold">${product.id ? 'Editar produto' : 'Novo produto'}</h2><button id="close-dialog" class="text-muted hover:text-text" aria-label="Fechar" type="button">×</button></header>
          <div class="space-y-4 px-6 py-5"><input name="id" type="hidden" value="${e(product.id || '')}" /><input name="existingImages" type="hidden" value="${e(JSON.stringify(product.images?.length ? product.images : image ? [{ url: image, alt: `Fotografia do produto: ${product.nome}`, order: 0, isCover: true }] : []))}" />
            <div class="grid gap-4 sm:grid-cols-2"><div><label for="nome" class="text-xs font-medium uppercase tracking-wider">Nome</label><input id="nome" name="nome" class="${input} mt-2" value="${e(product.nome || '')}" required /></div><div><label for="categoria" class="text-xs font-medium uppercase tracking-wider">Categoria</label><select id="categoria" name="categoria" class="${input} mt-2"><option value="catalogo" ${product.categoria !== 'kit' ? 'selected' : ''}>Catálogo</option><option value="kit" ${product.categoria === 'kit' ? 'selected' : ''}>Kits</option></select></div></div>
            <div class="grid gap-4 sm:grid-cols-2"><div><label for="preco" class="text-xs font-medium uppercase tracking-wider">Preço</label><input id="preco" name="preco" class="${input} mt-2" value="${e(product.preco || '')}" required /></div><div><label for="status-field" class="text-xs font-medium uppercase tracking-wider">Estado</label><select id="status-field" name="status" class="${input} mt-2"><option value="disponivel" ${product.status !== 'esgotado' ? 'selected' : ''}>Disponível</option><option value="esgotado" ${product.status === 'esgotado' ? 'selected' : ''}>Esgotado</option></select></div></div>
            <div><label for="descricao" class="text-xs font-medium uppercase tracking-wider">Descrição</label><textarea id="descricao" name="descricao" class="${input} mt-2 min-h-28 resize-y" required>${e(product.descricao || '')}</textarea></div>
            <div><label for="videoUrl" class="text-xs font-medium uppercase tracking-wider">Vídeo (opcional)</label><input id="videoUrl" name="videoUrl" class="${input} mt-2" value="${e(product.videoUrl || '')}" placeholder="https://..." /></div>
            <div><label for="images" class="text-xs font-medium uppercase tracking-wider">Imagens</label><input id="images" name="images" class="${input} mt-2" type="file" accept="image/*" multiple /><div class="mt-3 flex gap-3">${image ? `<img id="image-preview" class="h-24 w-24 rounded-xl border border-border bg-[#fafafa] object-cover" src="${e(image)}" alt="Pré-visualização da imagem" />` : '<div id="image-preview" class="h-24 w-24 rounded-xl border border-border bg-[#fafafa]"></div>'}<p class="max-w-xs text-sm leading-5 text-muted">A primeira imagem será usada como capa. Máximo de 8 MB por ficheiro.</p></div></div>
            <p id="form-status" class="hidden rounded-xl border px-4 py-3 text-sm"></p>
          </div><footer class="flex justify-end gap-3 border-t border-border px-6 py-4"><button id="cancel-dialog" class="${button}" type="button">Cancelar</button><button class="rounded-full bg-text px-4 py-2 text-xs font-semibold uppercase tracking-wider text-bg transition duration-300 hover:bg-accent" type="submit">Guardar</button></footer>
        </form></dialog>`;
    }

    async function renderAdmin() {
      const result = await request('list').catch(() => ({ ok: false }));
      if (!result.ok) { showLogin(); return; }
      const products = result.data.products || [];
      app.innerHTML = `${header(products)}<section class="mt-8"><div id="product-list" class="space-y-4">${products.map(productCard).join('')}</div><p id="status" class="mt-6 hidden rounded-xl border px-4 py-3 text-sm"></p></section>${dialog()}`;
      const statusEl = app.querySelector('#status');
      const setStatus = (message, error = false) => { statusEl.textContent = message; statusEl.className = `mt-6 rounded-xl border px-4 py-3 text-sm ${error ? 'border-red-200 text-red-700' : 'border-border text-muted'}`; };
      const openDialog = (product) => { app.querySelector('#product-dialog').remove(); app.insertAdjacentHTML('beforeend', dialog(product)); bindDialog(products); app.querySelector('#product-dialog').showModal(); };
      app.querySelector('#new-product').addEventListener('click', () => openDialog());
      app.querySelector('#fill-slugs').addEventListener('click', () => setStatus('Os links usam automaticamente o nome do produto como slug.'));
      app.addEventListener('click', async (event) => {
        const action = event.target.closest('[data-edit], [data-copy], [data-stock], [data-delete]'); if (!action) return;
        if (action.dataset.edit) openDialog(products.find((product) => String(product.id) === action.dataset.edit));
        if (action.dataset.copy) { await navigator.clipboard?.writeText(`${location.origin}${action.dataset.copy}`); setStatus('Link copiado para a área de transferência.'); }
        if (action.dataset.stock) { const product = products.find((entry) => String(entry.id) === action.dataset.stock); openDialog({ ...product, status: product.status === 'esgotado' ? 'disponivel' : 'esgotado' }); }
        if (action.dataset.delete) setStatus('A eliminação não está disponível nesta versão do serviço.', true);
      });
      bindDialog(products);
    }

    function bindDialog(products) {
      const modal = app.querySelector('#product-dialog'); if (!modal) return;
      const close = () => modal.close(); modal.querySelector('#close-dialog').addEventListener('click', close); modal.querySelector('#cancel-dialog').addEventListener('click', close);
      modal.querySelector('[name="images"]').addEventListener('change', (event) => { const file = event.target.files?.[0]; if (!file) return; const preview = modal.querySelector('#image-preview'); const url = URL.createObjectURL(file); if (preview.tagName === 'IMG') preview.src = url; else preview.outerHTML = `<img id="image-preview" class="h-24 w-24 rounded-xl border border-border bg-[#fafafa] object-cover" src="${url}" alt="Pré-visualização da imagem" />`; });
      modal.querySelector('#product-form').addEventListener('submit', async (event) => {
        event.preventDefault(); const form = event.currentTarget, feedback = modal.querySelector('#form-status'), data = new FormData(form), id = Number(data.get('id')) || Math.max(0, ...products.map((product) => Number(product.id) || 0)) + 1;
        const required = ['nome', 'preco', 'descricao']; if (required.some((name) => !String(data.get(name) || '').trim())) { feedback.textContent = 'Preencha os campos obrigatórios.'; feedback.className = 'rounded-xl border border-red-200 px-4 py-3 text-sm text-red-700'; return; }
        const files = data.getAll('images').filter((file) => file instanceof File && file.size); if (files.some((file) => !file.type.startsWith('image/') || file.size > 8 * 1024 * 1024)) { feedback.textContent = 'Use apenas imagens até 8 MB.'; feedback.className = 'rounded-xl border border-red-200 px-4 py-3 text-sm text-red-700'; return; }
        let response; if (files.length) { const upload = new FormData(); ['categoria', 'nome', 'preco', 'descricao', 'status', 'videoUrl'].forEach((key) => upload.append(key, String(data.get(key) || ''))); upload.append('id', String(id)); files.forEach((file) => upload.append('images', file)); response = await request('save', upload, true); } else { response = await request('save', { id, categoria: data.get('categoria'), nome: data.get('nome'), preco: data.get('preco'), descricao: data.get('descricao'), status: data.get('status'), videoUrl: data.get('videoUrl') || undefined, images: data.get('existingImages') }); }
        if (!response.ok || !response.data?.ok) { feedback.textContent = response.data?.error || 'Não foi possível guardar o produto.'; feedback.className = 'rounded-xl border border-red-200 px-4 py-3 text-sm text-red-700'; return; }
        modal.close(); renderAdmin();
      });
    }
    renderAdmin();
  </script>
</MainLayout>
