---
import MainLayout from "../../layouts/MainLayout.astro"; import Header from "../../components/Header.astro"; import ProductGrid from "../../components/ProductGrid.astro"; import FloatingWhatsApp from "../../components/FloatingWhatsApp.astro"; import { categoryLabel, categorySlug, getCategories, getProducts } from "../../lib/products"; import { site } from "../../site.config";
export async function getStaticPaths() {
  const all = await getProducts();
  const cats = getCategories(all);
  return cats.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}
const { category } = Astro.props; const all = await getProducts(); const items = all.filter((product) => categorySlug(product) === category.slug);
---
<MainLayout title={`${category.label} — ${site.name}`}><Header /><main id="conteudo-principal" class="mx-auto max-w-6xl px-4 py-10 sm:px-6"><p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-burgundy">Categoria</p><h1 class="mt-2 font-display text-4xl font-semibold text-brand-burgundy">{category.label}</h1><p class="mt-3 text-brand-ink/75">{items.length} produtos disponíveis nesta categoria.</p><div class="mt-8"><ProductGrid products={items} /></div></main><FloatingWhatsApp /></MainLayout>
