---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import ProductGrid from "../../components/ProductGrid.astro";
import ProductGallery from "../../components/ProductGallery.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import FloatingWhatsApp from "../../components/FloatingWhatsApp.astro";
import { categoryLabel, categorySlug, discount, productCover, productImages, productSlug, products } from "../../lib/products";
import { site } from "../../site.config";
export function getStaticPaths() { return products.map((product) => ({ params: { slug: productSlug(product) }, props: { product } })); }
const { product } = Astro.props;
const gallery = productImages(product);
const related = products.filter((item) => item.id !== product.id && categorySlug(item) === categorySlug(product)).slice(0, 4);
const percentDiscount = discount(product);
const schema = { "@context": "https://schema.org", "@type": "Product", name: product.nome, description: product.descricao, image: gallery.map((image) => image.url.startsWith("http") ? image.url : `${site.canonicalUrl}${image.url}`), offers: { "@type": "Offer", priceCurrency: "AOA", price: product.preco.replace(/[^\d,]/g, "").replace(/\./g, "").replace(",", "."), availability: product.status === "esgotado" ? "https://schema.org/OutOfStock" : "https://schema.org/InStock" } };
---
<MainLayout title={`${product.nome} — ${site.name}`} description={product.descricao} ogImage={productCover(product)}>
  <Header /><main id="conteudo-principal" class="mx-auto max-w-6xl px-4 py-10 sm:px-6"><a href="/produtos" class="text-sm font-semibold text-brand-burgundy underline underline-offset-4">← Voltar ao catálogo</a>
    <article class="mt-6 grid gap-8 lg:grid-cols-2 lg:items-start"><ProductGallery images={gallery} productName={product.nome} /><div class="rounded-2xl border border-brand-burgundy/10 bg-white p-6 shadow-soft sm:p-8"><p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-burgundy">{categoryLabel(product)}</p><h1 class="mt-3 font-display text-4xl font-semibold leading-tight text-brand-burgundy">{product.nome}</h1><div class="mt-5 flex items-baseline gap-3"><p class="font-display text-3xl font-semibold text-[#b42362]">{product.preco}</p>{product.preco_antigo && <del class="text-brand-ink/50">{product.preco_antigo}</del>}{percentDiscount && <span class="rounded-full bg-brand-rose/15 px-2 py-1 text-xs font-bold text-brand-burgundy">-{percentDiscount}%</span>}</div><p class="mt-6 leading-relaxed text-brand-ink/75">{product.descricao}</p>
      {product.variacoes?.length && <label class="mt-6 block text-sm font-semibold text-brand-burgundy">Escolha a variação<select data-variation class="mt-2 block w-full rounded-xl border-brand-burgundy/20"><option value="">Selecione uma opção</option>{product.variacoes.map((variation) => <option value={variation}>{variation}</option>)}</select></label>}
      <div class="mt-8" data-buy><WhatsAppButton nome={product.nome} preco={product.preco} phoneDigits={site.whatsappE164} disabled={product.status === "esgotado"} /></div></div></article>
    {related.length > 0 && <section class="mt-16" aria-labelledby="related-heading"><h2 id="related-heading" class="font-display text-3xl font-semibold text-brand-burgundy">Também pode gostar</h2><div class="mt-6"><ProductGrid products={related} /></div></section>}</main><FloatingWhatsApp /><script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script define:vars={{ name: product.nome, price: product.preco, phone: site.whatsappE164 }}>
    const variation = document.querySelector("[data-variation]"); const buy = document.querySelector("[data-buy] a");
    variation?.addEventListener("change", () => { if (!buy) return; const extra = variation.value ? ` Variação: *${variation.value}*.` : ""; buy.href = `https://wa.me/${phone}?text=${encodeURIComponent(`Olá! Vi o produto *${name}* por *${price}* no site e gostaria de comprar.${extra}`)}`; });
  </script>
</MainLayout>
