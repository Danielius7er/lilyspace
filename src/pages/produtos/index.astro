---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import ProductGrid from "../../components/ProductGrid.astro";
import FloatingWhatsApp from "../../components/FloatingWhatsApp.astro";
import { categories, categorySlug, priceNumber, products } from "../../lib/products";
import { site } from "../../site.config";
---
<MainLayout title={`Produtos — ${site.name}`}><Header /><main id="conteudo-principal" class="mx-auto max-w-6xl px-4 py-10 sm:px-6"><p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-burgundy">Catálogo</p><h1 class="mt-2 font-display text-4xl font-semibold text-brand-burgundy">Todos os produtos</h1><p class="mt-3 max-w-2xl text-brand-ink/75">Use os filtros para encontrar o que procura. A encomenda é confirmada diretamente pelo WhatsApp.</p>
  <div class="mt-8 grid gap-3 rounded-2xl border border-brand-burgundy/10 bg-white p-4 sm:grid-cols-2 lg:grid-cols-5">
    <label class="text-sm font-semibold text-brand-burgundy">Buscar<input data-search type="search" placeholder="Nome do produto" class="mt-1 block w-full rounded-lg border-brand-burgundy/20 text-sm" /></label>
    <label class="text-sm font-semibold text-brand-burgundy">Categoria<select data-category class="mt-1 block w-full rounded-lg border-brand-burgundy/20 text-sm"><option value="">Todas</option>{categories.map((category) => <option value={category.slug}>{category.label}</option>)}</select></label>
    <label class="text-sm font-semibold text-brand-burgundy">Preço<select data-price class="mt-1 block w-full rounded-lg border-brand-burgundy/20 text-sm"><option value="">Todos</option><option value="0-3000">Até 3.000 Kz</option><option value="3001-5000">3.001–5.000 Kz</option><option value="5001-999999">Acima de 5.000 Kz</option></select></label>
    <label class="text-sm font-semibold text-brand-burgundy">Disponibilidade<select data-status class="mt-1 block w-full rounded-lg border-brand-burgundy/20 text-sm"><option value="">Todos</option><option value="disponivel">Disponível</option><option value="esgotado">Esgotado</option></select></label>
    <label class="text-sm font-semibold text-brand-burgundy">Ordenar<select data-sort class="mt-1 block w-full rounded-lg border-brand-burgundy/20 text-sm"><option value="recent">Mais recentes</option><option value="low">Menor preço</option><option value="high">Maior preço</option><option value="name">Ordem alfabética</option></select></label>
  </div>
  <p data-count class="mt-6 text-sm text-brand-ink/65">{products.length} produtos encontrados</p>
  <div class="mt-5" data-product-list><ProductGrid products={products} /></div><p data-empty class="mt-8 hidden text-center text-brand-ink/70">Não encontrámos produtos com estes filtros.</p>
</main><FloatingWhatsApp />
<script define:vars={{ products: products.map((p) => ({ ...p, category: categorySlug(p), price: priceNumber(p.preco) })) }}>
  const list = document.querySelector("[data-product-list]"); const count = document.querySelector("[data-count]"); const empty = document.querySelector("[data-empty]");
  const controls = ["search", "category", "price", "status", "sort"].map((key) => document.querySelector(`[data-${key}]`));
  function applyFilters() { const [search, category, price, status, sort] = controls.map((control) => control.value); let visible = [...products];
    if (search) visible = visible.filter((p) => p.nome.toLocaleLowerCase().includes(search.toLocaleLowerCase()));
    if (category) visible = visible.filter((p) => p.category === category); if (status) visible = visible.filter((p) => (p.status || "disponivel") === status); if (price) { const [min, max] = price.split("-").map(Number); visible = visible.filter((p) => p.price >= min && p.price <= max); }
    visible.sort((a,b) => sort === "low" ? a.price-b.price : sort === "high" ? b.price-a.price : sort === "name" ? a.nome.localeCompare(b.nome) : b.id-a.id);
    const cards = Array.from(list.querySelectorAll("li")); cards.forEach((card) => { const name = card.querySelector("h2")?.textContent; card.classList.toggle("hidden", !visible.some((p) => p.nome === name)); });
    count.textContent = `${visible.length} produto${visible.length === 1 ? "" : "s"} encontrado${visible.length === 1 ? "" : "s"}`; empty.classList.toggle("hidden", visible.length !== 0);
  } controls.forEach((control) => control.addEventListener(control.matches("input") ? "input" : "change", applyFilters));
</script></MainLayout>
